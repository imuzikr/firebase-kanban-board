rules_version = '2';

// See README.md's "데이터 구조" section for the full collection layout and
// the reasoning behind each design choice. This file is the ONLY
// enforcement layer in this app — there is no server, so every guarantee
// (a student can never see another student's list/cards, only the
// teacher can flip a card's visibility, no one can self-promote to
// teacher, etc.) has to hold here.
service cloud.firestore {
  match /databases/{database}/documents {

    // EDIT this before deploying to a real project — the only account that
    // can ever become 'teacher' is whichever signs up with this email.
    // Keep it a placeholder in the committed file; edit your local/deployed
    // copy only (see README.md's PII/secrets checklist).
    function teacherEmail() {
      return "teacher@example.com";
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacherOfClass(classId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    // Like isTeacherOfClass(), but also true when THIS SAME request is the
    // one creating that class. get() inside rules only sees the database as
    // it was BEFORE this request's own writes, so when createClass()'s
    // transaction creates classes/{classId} and its joinCode + seed list
    // together, the joinCode/list create rules would otherwise see the
    // class as "not existing yet" and get rejected. getAfter() evaluates as
    // if every write in this request has already landed, which fixes that.
    // Only used where a class is created atomically alongside a child doc
    // (joinCodes, the teacher's seed list) — everywhere else the class
    // already exists, so plain isTeacherOfClass() is correct as-is.
    function isTeacherOfClassIncludingPending(classId) {
      return isSignedIn() &&
        getAfter(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    function isClassMember(classId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/classMembers/$(classId + '_' + request.auth.uid));
    }

    // Mirrors Postgres's can_modify_list(): teacher can modify any list on
    // their own class's board; a student can only modify their own list.
    function canModifyList(listId, classId) {
      let list = get(/databases/$(database)/documents/lists/$(listId)).data;
      return (list.listType == 'teacher' && isTeacherOfClass(classId))
        || (list.listType == 'student' && (list.ownerId == request.auth.uid || isTeacherOfClass(classId)));
    }

    // ── profiles ───────────────────────────────────────────────────
    // Self-read only — nothing in the UI ever needs another user's
    // profile doc (a student's list title already carries their display
    // name, set once at creation).
    match /profiles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      // role is decided HERE, by comparing the verified email claim on the
      // caller's own ID token to teacherEmail() — this is the one and only
      // place a role is ever assigned, and it can't be forged or chosen by
      // the client (the claim is signed by Firebase, not client data).
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role ==
           (request.auth.token.email.lower() == teacherEmail() ? 'teacher' : 'student')
        && request.resource.data.keys().hasOnly(['displayName', 'role', 'createdAt']);

      // role can never change after creation (no self-promotion).
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);

      allow delete: if false;
    }

    // ── classes ────────────────────────────────────────────────────
    match /classes/{classId} {
      allow read: if isSignedIn() &&
        (resource.data.teacherId == request.auth.uid || isClassMember(classId));

      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'teacherId', 'joinCode', 'schedule', 'position', 'createdAt']);

      // teacherId/joinCode/createdAt are immutable once set.
      allow update: if isSignedIn() && resource.data.teacherId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'schedule', 'position']);

      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    // ── joinCodes ──────────────────────────────────────────────────
    // Doc ID IS the code — lookup is a single get(), never a query, so a
    // student never gets list/query access to enumerate codes.
    match /joinCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn() && isTeacherOfClassIncludingPending(request.resource.data.classId)
        && request.resource.data.keys().hasOnly(['classId']);

      allow update: if false;
      allow delete: if isSignedIn() && isTeacherOfClass(resource.data.classId);
    }

    // ── classMembers ───────────────────────────────────────────────
    // Deterministic id `{classId}_{studentId}` stands in for
    // unique(class_id, student_id) + "insert, ignore if exists".
    //
    // allow read (not split get/list) is deliberate: a student's dashboard
    // needs to query `where('studentId','==',myUid)` to find every class
    // they've joined, which only works as a `list` query if the rule can
    // prove it from that same filter — a student querying their own uid is
    // provable via the first OR branch; a student trying to query anyone
    // else's uid is not (the second branch depends on classId, which
    // isn't fixed by that filter), so Firestore rejects it. A teacher can
    // similarly query `where('classId','==',theirOwnClassId)` for a roster.
    match /classMembers/{memberId} {
      allow read: if isSignedIn() &&
        (resource.data.studentId == request.auth.uid || isTeacherOfClass(resource.data.classId));

      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && memberId == request.resource.data.classId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['classId', 'studentId', 'joinedAt']);

      allow update: if false;
      allow delete: if isSignedIn() && isTeacherOfClass(resource.data.classId);
    }

    // ── lists ──────────────────────────────────────────────────────
    // A list belongs to exactly one person. Teacher's list(s): visible to
    // the whole class. Student's list: visible only to that student + the
    // teacher — nothing here grants another student access.
    //
    // Query shape matters here (see cards below for the full explanation):
    // a teacher can query `where('classId','==',classId)` directly since
    // isTeacherOfClass() doesn't depend on any per-document field. A
    // student must split into two narrow queries —
    //   where('classId','==',classId).where('listType','==','teacher')
    //   where('classId','==',classId).where('listType','==','student').where('ownerId','==',uid)
    // — so every candidate document the query could match is provably
    // covered by one single branch of the rule below.
    match /lists/{listId} {
      allow read: if isSignedIn() && (
        (resource.data.listType == 'teacher' &&
          (isTeacherOfClass(resource.data.classId) || isClassMember(resource.data.classId)))
        || (resource.data.listType == 'student' &&
          (resource.data.ownerId == request.auth.uid || isTeacherOfClass(resource.data.classId)))
      );

      // Teacher list: only the teacher of that class, and only list_type='teacher'
      // (mirrors lists_insert_teacher — a student can never force-add a list).
      allow create: if isSignedIn() && request.resource.data.listType == 'teacher'
        && request.resource.data.ownerId == request.auth.uid
        && isTeacherOfClassIncludingPending(request.resource.data.classId)
        && request.resource.data.keys().hasOnly(['classId', 'listType', 'ownerId', 'title', 'position', 'createdAt']);

      // Student list: only that student, only their own deterministic id,
      // only for a class that actually exists (join-by-code already
      // verified membership in the same transaction).
      allow create: if isSignedIn() && request.resource.data.listType == 'student'
        && request.resource.data.ownerId == request.auth.uid
        && listId == 'student_' + request.resource.data.classId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['classId', 'listType', 'ownerId', 'title', 'position', 'createdAt']);

      // Lists are never edited after creation (no drag-reorder for lists
      // in this app, only for their cards) — only created or deleted.
      allow update: if false;

      // Any list on the teacher's own class can be deleted by that
      // teacher — including student-type lists, needed so deleteClass()
      // can cascade-delete every list on a class (Firestore has no
      // ON DELETE CASCADE, so the client issues these deletes itself).
      // The app's UI only ever offers a delete *button* for teacher-type
      // lists though (student lists are meant to be auto-managed by
      // membership, not manually deletable in isolation) — this rule is
      // deliberately broader than the UI to allow that cascade, not an
      // invitation to add a "delete a student's list" feature.
      allow delete: if isSignedIn() && isTeacherOfClass(resource.data.classId);
    }

    // ── cards ──────────────────────────────────────────────────────
    function cardVisible(card) {
      let list = get(/databases/$(database)/documents/lists/$(card.listId)).data;
      return isTeacherOfClass(card.classId)
        || (isClassMember(card.classId) && list.listType == 'teacher' && card.visibility == 'public')
        || (list.listType == 'student' && list.ownerId == request.auth.uid);
    }

    match /cards/{cardId} {
      allow read: if isSignedIn() && cardVisible(resource.data);

      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid
        && canModifyList(request.resource.data.listId, request.resource.data.classId)
        && request.resource.data.keys().hasOnly(
             ['listId', 'classId', 'title', 'description', 'position', 'visibility', 'createdBy', 'createdAt', 'updatedAt', 'displayDate'])
        // a card on anything but the teacher's list is always public — the
        // public/private distinction only means something on the teacher's
        // list, a student's own list is already fully private regardless.
        && (get(/databases/$(database)/documents/lists/$(request.resource.data.listId)).data.listType == 'teacher'
            || request.resource.data.visibility == 'public');

      // Visibility can only be flipped by the class's teacher, and only
      // visibility — kept as its own rule so it can't piggyback on a
      // content edit.
      allow update: if isSignedIn() && isTeacherOfClass(resource.data.classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibility']);

      // Content/position edits: teacher, or the list's own owner. Cards
      // only ever move within their own list (see Board drag logic), so
      // this only needs to check the one list the card is already on.
      allow update: if isSignedIn() && canModifyList(resource.data.listId, resource.data.classId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'description', 'position', 'displayDate', 'updatedAt']);

      allow delete: if isSignedIn() && canModifyList(resource.data.listId, resource.data.classId);
    }
  }
}
