# Copy this file to .env and fill in your own real Firebase project's
# values (Firebase Console > Project settings > your web app). These are
# the public, client-side Firebase config — safe to expose in a browser
# bundle, Firestore Security Rules are the actual access control — but
# there is no reason to commit a specific real project's values either,
# so this file stays untracked (see .gitignore).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: set to "true" to use the Firebase Local Emulator Suite instead
# of the real project above (requires a Java runtime — see README.md).
VITE_USE_FIREBASE_EMULATOR=false

# Must match firestore.rules' teacherEmail() exactly (case-insensitive).
# Firestore Security Rules can only allow/deny a write, never rewrite its
# data — so the client has to already know which role to *propose* when
# creating its own profiles/{uid} doc at signup, or the rule will reject a
# guess that doesn't match. This value is NOT the enforcement (the rule
# is — it separately re-derives the same comparison against the caller's
# verified ID token email, which the client can't forge), it just lets
# signup construct a request that the rule will actually accept. Keep
# this and firestore.rules' teacherEmail() in sync by hand.
VITE_TEACHER_EMAIL=teacher@example.com
